generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  USER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  MOBILE_WALLET
  INVESTMENT
  OTHER
}

enum TodoStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationType {
  SYSTEM
  BUDGET
  SAVINGS
  TODO
  SECURITY
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  name                String
  avatarUrl           String?
  defaultCurrency     String         @default("USD")
  timezone            String         @default("UTC")
  locale              String         @default("en-US")
  status              String         @default("ACTIVE")
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  roles               UserRole[]
  sessions            Session[]
  accounts            Account[]
  transactions        Transaction[]
  categories          Category[]
  budgets             Budget[]
  savingsPots         SavingsPot[]
  todos               Todo[]
  settings            UserSetting[]
  auditLogs           AuditLog[]
  incomes             Income[]
  recurringTransactions RecurringTransaction[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([deletedAt])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id           String        @id @default(uuid())
  userId       String
  name         String
  type         AccountType
  currencyCode String        @default("USD")
  openingBalance Decimal     @db.Decimal(20, 4) @default(0)
  isArchived   Boolean       @default(false)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, isArchived])
}

model Category {
  id           String        @id @default(uuid())
  userId       String?
  name         String
  icon         String?
  color        String?
  displayOrder Int           @default(0)
  categoryType TransactionType @default(EXPENSE)
  isSystem     Boolean       @default(false)
  isArchived   Boolean       @default(false)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budgets      BudgetCategory[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name, parentId])
  @@index([isSystem, isArchived])
}

model Transaction {
  id            String          @id @default(uuid())
  userId        String
  accountId     String
  categoryId    String?
  type          TransactionType
  amount        Decimal         @db.Decimal(20, 4)
  currencyCode  String
  transactionAt DateTime
  merchant      String?
  description   String?
  attachmentUrl String?
  paymentMethod String?
  deletedAt     DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, transactionAt])
  @@index([accountId, transactionAt])
  @@index([categoryId])
  @@index([deletedAt])
}

model Budget {
  id        String           @id @default(uuid())
  userId    String
  month     DateTime
  amount    Decimal          @db.Decimal(20, 4)
  currencyCode String
  rollover  Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, month])
  @@index([month])
}

model BudgetCategory {
  id         String   @id @default(uuid())
  budgetId   String
  categoryId String
  amount     Decimal  @db.Decimal(20, 4)
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetId, categoryId])
}

model SavingsPot {
  id            String            @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal           @db.Decimal(20, 4)
  currentAmount Decimal           @db.Decimal(20, 4) @default(0)
  currencyCode  String
  targetDate    DateTime?
  color         String?
  icon          String?
  archivedAt    DateTime?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  SavingsTransaction[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId, archivedAt])
}

model SavingsTransaction {
  id            String     @id @default(uuid())
  savingsPotId  String
  amount        Decimal    @db.Decimal(20, 4)
  type          String
  description   String?
  occurredAt    DateTime   @default(now())
  savingsPot    SavingsPot @relation(fields: [savingsPotId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@index([savingsPotId, occurredAt])
}

model Todo {
  id          String       @id @default(uuid())
  userId      String
  title       String
  description String?
  status      TodoStatus   @default(PENDING)
  priority    TodoPriority @default(MEDIUM)
  dueAt       DateTime?
  amount      Decimal?     @db.Decimal(20, 4)
  completedAt DateTime?
  deletedAt   DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status, dueAt])
  @@index([deletedAt])
}

model UserSetting {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model ApplicationSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  description String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  targetId   String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Income {
  id           String   @id @default(uuid())
  userId       String
  accountId    String?
  name         String
  amount       Decimal  @db.Decimal(20, 4)
  currencyCode String
  incomeAt     DateTime
  source       String?
  description  String?
  deletedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, incomeAt])
  @@index([deletedAt])
}

model RecurringTransaction {
  id            String              @id @default(uuid())
  userId        String
  accountId     String?
  categoryId    String?
  type          TransactionType
  amount        Decimal             @db.Decimal(20, 4)
  currencyCode  String
  description   String?
  frequency     RecurrenceFrequency
  nextRunAt     DateTime
  lastRunAt     DateTime?
  isActive      Boolean             @default(true)
  deletedAt     DateTime?
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, isActive, nextRunAt])
  @@index([deletedAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  readAt    DateTime?
  deletedAt DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([deletedAt])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  message     String
  link        String?
  severity    String   @default("INFO")
  isActive    Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
